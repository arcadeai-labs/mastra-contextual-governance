{
  "$schema_note": "Hand-written. Not generated, not vendored — see contract/README.md.",
  "description": "Cross-language test vectors for minimum-sufficient-clearance approver routing (#9). The roles below are deliberately neutral: this contract is shared by the reusable TypeScript and Python routers and must not encode one application's domain. Consumed by packages/governance-core/test/approver-router.test.ts and by tools/approvals/tests/test_routing.py, so the two implementations are checked against the same rows rather than argued to agree.",
  "rule": [
    "1. Drop the requester, always, even when their own clearance would cover the amount.",
    "2. Drop everyone whose clearance is below the amount. Clearance is a ceiling, so clearance == amount is sufficient.",
    "3. Of those left, pick the lowest clearance.",
    "4. Tie-break equal clearances by user_id ascending, compared as raw strings — never locale-aware. JavaScript orders by UTF-16 code unit and Python by code point; they agree across the Basic Multilingual Plane, which covers every address either roster will ever hold.",
    "Having nobody eligible is an ordinary outcome, not an error. A non-finite or negative amount is a programming error and must raise."
  ],
  "subjects": {
    "dana": { "user_id": "alice@example.com", "display_name": "Alice", "role": "operator", "clearance": 50000 },
    "sam": { "user_id": "bob@example.com", "display_name": "Bob", "role": "analyst", "clearance": 0 },
    "riley": { "user_id": "charlie@example.com", "display_name": "Charlie", "role": "supervisor", "clearance": 250000 },
    "morgan": { "user_id": "michael@example.com", "display_name": "Michael", "role": "executive", "clearance": 5000000 },
    "upper": { "user_id": "Zed@example.com", "display_name": "Zed", "role": "supervisor", "clearance": 100 },
    "lower": { "user_id": "abe@example.com", "display_name": "Abe", "role": "supervisor", "clearance": 100 },
    "middle": { "user_id": "bea@example.com", "display_name": "Bea", "role": "supervisor", "clearance": 100 }
  },
  "cast": ["morgan", "dana", "sam", "riley"],
  "cases": [
