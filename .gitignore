# deps
node_modules/
.venv/
__pycache__/

# build
.next/
dist/
build/
*.tsbuildinfo

# Next 16 writes these itself (#190). next-env.d.ts differs between `next dev`
# and `next build`, and Next's docs say to ignore it; `next typegen` in
# apps/web's typecheck script regenerates it. AGENTS.md and CLAUDE.md are
# written by `next dev` whenever it detects an AI agent running it.
apps/web/next-env.d.ts
apps/web/AGENTS.md
apps/web/CLAUDE.md
# apps/web/test/dev-port.test.ts's throwaway Next project, removed after the run.
apps/web/.test-fixtures/

# env — per-worktree ports, written by scripts/orca-setup.sh
.env
.env.local
.env.*.local

# data — bootstrapped from checked-in fixtures, never committed
*.db
*.db-journal
*.sqlite

# Orca — role prompts in .orca/ are committed and public-safe. Everything under
# local/ is machine-specific: env.md holds the Orca repo UUID and Run id,
# human/ is the operator's gate briefs, state/ is the driver's journal and DAG.
.orca/local/

# local agent config
.claude/settings.local.json
.claude/worktrees/
.mcp.json

# os
.DS_Store
